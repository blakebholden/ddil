# .env.airgapped — backend config for the FULLY AIRGAPPED SEC Findings demo.
# Copy to demo/backend/.env on the kit (overwrites the bench-pointing .env) and
# restart the backend. All inference is local; no Bedrock, no AWS, no internet.

# ── SEC query embedding: LOCAL instead of Bedrock ─────────────────────────
VINEYARD_EMBED_BACKEND=ollama
VINEYARD_EMBED_MODEL=nomic-embed-text
VINEYARD_OLLAMA_EMBED_URL=http://192.168.1.20:11434

# ── LLM (Agent Builder runs through the Kibana connector, not this directly) ─
VINEYARD_LLM_MODEL=gpt-oss:120b
VINEYARD_OLLAMA_LLM_URL=http://192.168.1.20:11434

# ── Elasticsearch — SEC index lives on the GPU node (DGX Spark) ───────────
VINEYARD_ES_GPU_HOST=192.168.1.20
VINEYARD_ES_GPU_PORT=9200
VINEYARD_SEC_INDEX=sec_10k_2026
# Uncomment if ES security is enabled:
#VINEYARD_ES_USER=elastic
#VINEYARD_ES_PASSWORD=changeme

# ── Kibana / Agent Builder (local, default space) ─────────────────────────
VINEYARD_KIBANA_URL=http://192.168.1.10:5601
VINEYARD_KIBANA_SPACE=default
#VINEYARD_KIBANA_USER=elastic
#VINEYARD_KIBANA_PASSWORD=changeme
VINEYARD_AGENT_BUILDER_AGENT_ID=finance-analyst
# Set to the connector id printed by provision-connector-local.sh:
VINEYARD_AGENT_BUILDER_CONNECTOR_ID=finance-ollama-llm

# ── Jina multimodal + DLS adventure (adventure 3) ─────────────────────────
VINEYARD_JINA_OMNI_URL=http://192.168.1.20:8081
VINEYARD_JINA_OMNI_MODEL=jina-embeddings-v5-omni-small
# JINA_ES_URL falls back to es_gpu_url if unset
#VINEYARD_JINA_ES_URL=http://192.168.1.20:9200
# On-box media mounts (must match where you staged the data — see JINA-SETUP.md)
VINEYARD_JINA_IMG_DIR=/data/jina/images
VINEYARD_JINA_FIG_DIR=/data/jina/scale/extracted_imgs
VINEYARD_JINA_PDF_DIR=/data/jina/scale/samples

# ── CCS edge-federation (adventure 4) ─────────────────────────────────────
# The ECH (Elastic Cloud Hosted) coordinating cluster that adds the box as a
# remote. Real values are secrets — keep them in the gitignored .env, NOT here.
VINEYARD_ECH_ES_URL=https://<deployment>.es.us-east-1.aws.found.io:443
#VINEYARD_ECH_API_KEY=<apikey>          # set in gitignored .env only
VINEYARD_CCS_REMOTE_ALIAS=edge
VINEYARD_CCS_BOX_PROXY=<box-proxy-host>:9443
VINEYARD_CCS_INDEX=field-reports
